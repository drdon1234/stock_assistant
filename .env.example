# 复制为 .env 后填写，docker compose 会自动读取

# 数据库密码（必填）
DB_PASSWORD=

# 数据目录：其下 mariadb/ 为数据库，app/ 为 K 线缓存、日志、代理与 Cookie 配置
INSTOCK_HOME=./data

# 网页端口
INSTOCK_PORT=9988

# 网页登录：启动时若该账号不存在则创建为管理员。也可留空，启动后运行
# docker exec -it instock-web python -m instock user add <账号> 创建
INSTOCK_ADMIN_USER=
INSTOCK_ADMIN_PASSWORD=

# 部署在 Nginx/Caddy 等反向代理（HTTPS）之后时设为 1，以识别真实客户端 IP 与 HTTPS
INSTOCK_TRUST_PROXY=

# 聚宽策略回测：历史数据回补起始日期与 BaoStock 并发进程数（首次回补运行 python -m instock quant sync）
INSTOCK_QUANT_START=2005-01-01
INSTOCK_QUANT_WORKERS=4

# 镜像（默认 Docker Hub 最新版，可改为固定版本如 drdon1234/stock_assistant:0.0.1）
INSTOCK_IMAGE=drdon1234/stock_assistant:latest
